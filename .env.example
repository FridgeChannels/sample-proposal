PORT=4173

# PostHog (browser). Leave unset to disable analytics entirely.
# Project token + host: https://app.posthog.com → Project Settings
# VITE_POSTHOG_PROJECT_TOKEN=phc_xxxxxxxx
# VITE_POSTHOG_HOST=https://us.i.posthog.com
# Optional: enable session replay (heavier). Default off.
# VITE_POSTHOG_SESSION_REPLAY=true

# Supabase — used by /p/{sn} to choose sample vs live HTML (magnet_brand_param.status)
# and by pilot quote / Stripe Invoice (packages + customer_package_discounts).
# Prefer the service role key so RLS does not block lookups.
# Same values as fc_lead_data admin (.env).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
# Optional fallback when SERVICE_ROLE_KEY is unset:
# SUPABASE_API_KEY=replace_with_anon_or_service_key

# Stripe Invoicing (server-only). Frontend may only send { orderId, handoffToken }.
# Invoice email is resolved from finance_handoff / customer.email and sent by Stripe.
# Payment confirmation + discount redemption are handled by the dedicated Stripe
# webhook service — see docs/stripe-invoice-webhook-contract.md.
STRIPE_SECRET_KEY=sk_test_replace_me

# Google Places (New) — server-only key for shipping address suggestions.
# Enable Places API (New) in Google Cloud and restrict this key to that API.
GOOGLE_MAPS_API_KEY=replace_with_server_key

# Optional Resend email for finance handoffs (without it, handoff returns preview status).
# RESEND_API_KEY=
# FINANCE_FROM_EMAIL=FridgeChannel <orders@fridgechannel.com>
