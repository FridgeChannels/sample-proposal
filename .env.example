PORT=4173

# PostHog (browser). Leave unset to disable analytics entirely.
# Project token + host: https://app.posthog.com → Project Settings
# VITE_POSTHOG_PROJECT_TOKEN=phc_xxxxxxxx
# VITE_POSTHOG_HOST=https://us.i.posthog.com
# Optional: enable session replay (heavier). Default off.
# VITE_POSTHOG_SESSION_REPLAY=true
#
# Docker: these VITE_* values are baked in at `docker compose build` / `docker build`.
# Runtime `env_file: .env` does not enable PostHog. Rebuild after changing them.

# Supabase — used by /p/{sn} to choose sample vs live HTML (magnet_brand_param.status)
# and by pilot quote / Stripe Invoice (packages + customer_package_discounts).
# Prefer the service role key so RLS does not block lookups.
# Same values as fc_lead_data admin (.env).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
# Optional fallback when SERVICE_ROLE_KEY is unset:
# SUPABASE_API_KEY=replace_with_anon_or_service_key

# Stripe Invoicing (server-only). Frontend may only send { orderId, handoffToken }.
# Invoice email is resolved from finance_handoff / customer.email and sent by Stripe.
# Payment confirmation + discount redemption are handled by the dedicated Stripe
# webhook service — see docs/stripe-invoice-webhook-contract.md.
STRIPE_SECRET_KEY=sk_test_replace_me

# Google Places (New) — server-only key for shipping address suggestions.
# Enable Places API (New) in Google Cloud and restrict this key to that API.
GOOGLE_MAPS_API_KEY=replace_with_server_key

# Optional Resend email for finance handoffs (without it, handoff returns preview status).
# RESEND_API_KEY=
# FINANCE_FROM_EMAIL=FridgeChannel <orders@fridgechannel.com>

# Pilot-plan prep (internal): Calendly + lead_data + dashboard SSO
# Gate /pilot-plan/* with a shared team access key (HttpOnly cookie, 90 days by default).
# Leave PILOT_OPS_ACCESS_KEY unset only for local dev without auth.
PILOT_OPS_ACCESS_KEY=
# Optional: separate cookie signing secret (defaults to PILOT_OPS_ACCESS_KEY).
# PILOT_OPS_COOKIE_SECRET=
# PILOT_OPS_COOKIE_TTL_DAYS=90
# Create PAT: https://calendly.com/integrations/api_webhooks → Personal Access Tokens
CALENDLY_PAT=

# Christmas ASIN / DTC campaign form → Notion Applications DB (MarkAPI integration).
# Token is also loaded from ../fc_lead_data/.env when present.
# NOTION_API_TOKEN=ntn_xxxxxxxx
# Database: FC3.0-ChristmasPilotDB
NOTION_CHRISTMAS_PILOT_DATABASE_ID=3d79166f-d9fd-81ef-92fb-f1bcc3b9d431
# Optional: HMAC secret for form timing tokens (falls back to PILOT_OPS / Notion token).
# CHRISTMAS_CAMPAIGN_FORM_SECRET=
# Optional: extra allowed browser origins (comma-separated). Same Host is always allowed.
# CHRISTMAS_CAMPAIGN_ALLOWED_ORIGINS=https://your-custom-domain.com
# CALENDLY_USER_URI=          # optional; defaults to /users/me
LEAD_DATA_BASE_URL=http://127.0.0.1:3000
DTC_DASHBOARD_URL=http://localhost:8081
DTC_DASHBOARD_API_KEY=        # must match DTC-Dashboard-2 API_KEY

# Checkout legal PDFs — optional CDN / S3 base (no trailing slash).
# Upload to s3://{bucket}/legal/pilot-order-service-terms-en.pdf and
# s3://{bucket}/legal/data-processing-addendum-en.pdf with Content-Type application/pdf.
# Example: VITE_LEGAL_DOCS_BASE_URL=https://your-cdn.example.com/legal
# Leave empty to serve PDFs from /legal/ on this app (public/legal → dist/legal).
VITE_LEGAL_DOCS_BASE_URL=https://amzn-s3-fc-bucket.s3.sa-east-1.amazonaws.com/legal/
