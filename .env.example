PORT=4173

# Supabase — used by /p/{sn} to choose sample vs live HTML (magnet_brand_param.status)
# and by pilot quote / Stripe checkout (packages + customer_package_discounts).
# Prefer the service role key so RLS does not block lookups.
# Same values as fc_lead_data admin (.env).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
# Optional fallback when SERVICE_ROLE_KEY is unset:
# SUPABASE_API_KEY=replace_with_anon_or_service_key

# Stripe Checkout (server-only). Frontend may only send { orderId } or { sn, quantity }.
STRIPE_SECRET_KEY=sk_test_replace_me
# Webhook signing secret from Stripe Dashboard → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Optional overrides; defaults append to the request Origin.
# STRIPE_SUCCESS_URL=https://sample.fridgechannels.com/p/{sn}?checkout=success#order
# STRIPE_CANCEL_URL=https://sample.fridgechannels.com/p/{sn}?checkout=cancel#order

# Optional Resend email for finance handoffs (without it, handoff returns preview status).
# RESEND_API_KEY=
# FINANCE_FROM_EMAIL=FridgeChannel <orders@fridgechannel.com>
